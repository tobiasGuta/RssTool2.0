# ─────────────────────────────────────────────────────────────
#  RssTool2.0 — Environment Variables
#  Copy this file to .env and fill in your values.
#  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────
# Your Discord bot token (from https://discord.com/developers/home)
DISCORD_TOKEN=your_discord_bot_token_here

# The default name and avatar for the bot's webhooks
WEBHOOK_NAME=RssTool2.0
WEBHOOK_AVATAR_PATH=avatar.png

# ── OPTIONAL: Notifications ───────────────────────────────────
# Discord webhook for system startup/shutdown messages
SYSTEM_WEBHOOK_URL=

# ntfy.sh topic URL for push notifications to your phone
# Create a free topic at https://ntfy.sh
# Example: https://ntfy.sh/my-rsstool-alerts
NTFY_URL=

# ── OPTIONAL: Tuning ──────────────────────────────────────────
# How often to check RSS feeds (seconds, default 300 = 5 min)
RSS_CHECK_INTERVAL=300

# How often to check Twitch streams (seconds, default 120 = 2 min)
TWITCH_CHECK_INTERVAL=120

# Delay between sending Discord messages (seconds, default 5)
SEND_INTERVAL=5

# Only show articles published within this many hours (default 24)
MAX_ARTICLE_AGE_HOURS=24

# Maximum restarts before supervisor gives up on a service
MAX_RESTARTS=10

# ── OPTIONAL: Dashboard ───────────────────────────────────────
# Host to bind the dashboard to (0.0.0.0 = all interfaces = accessible on LAN)
DASHBOARD_HOST=0.0.0.0

# Port for the web dashboard
DASHBOARD_PORT=8080

# ── OPTIONAL: Storage ─────────────────────────────────────────
# Path to the SQLite database file
DB_PATH=data/rsstool.db
